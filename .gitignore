# Local build outputs. Keep Android APKs available for Git LFS releases.
/builds/*
!/builds/android/
/builds/android/*
!/builds/android/*-v*-release.apk

# Local backup/output folders that should not be committed.
/asset_backups/
/dist/
/art/generated/

# Accidental wrong-root outputs. The Ren'Py project lives in /Sam And Em.
/game/
/prompts/
/scripts/Sam And Em/
/scripts/art/

# Python caches.
**/__pycache__/
*.pyc
