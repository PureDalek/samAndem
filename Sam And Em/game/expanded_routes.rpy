label expanded_route_hub:

    scene bg dorm_lobby
    with fade

    "West Hall keeps opening new doors. Some are friendships. Some are evidence. Some are traps with better lighting."

    menu:
        "Choose an expanded route to preview, or continue the current Maxine/Lady story."

        "Morrigan Vale - nerd goth occult-studies tutor":
            jump expanded_route_morrigan

        "Brielle Ashford - blonde bully and legacy-donor queen":
            jump expanded_route_brielle

        "Mina Sato - art major and mural rebel":
            jump expanded_route_mina

        "Kira Sol - cosplayer and prop-engineering prodigy":
            jump expanded_route_kira

        "Sienna Cross - swimmer and scholarship rival":
            jump expanded_route_sienna

        "Nadia Quinn - campus nurse and quiet whistleblower":
            jump expanded_route_nadia

        "Headmaster Helena Voss - evil headmaster and academy power broker":
            jump expanded_route_helena

        "Rhea Mallory - campus reporter and debate-club tactician":
            jump expanded_route_rhea

        "Play the 10 binary situation gauntlet.":
            jump expanded_binary_situations

        "Continue the Maxine/Lady route.":
            jump route_act_one

